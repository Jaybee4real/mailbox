# ─── Tenant identity ────────────────────────────────────────────────────────
# Every mailbox address lives on this domain.
MAIL_ADDRESS_DOMAIN=example.com
MAIL_FROM="Example <info@example.com>"
MAIL_SUPPORT_EMAIL=info@example.com

# The origin used for links that go out in email (password resets, the open pixel).
# Never derived from the request: the Host header is caller-controlled.
MAIL_PUBLIC_URL=https://mail.example.com

# ─── Branding (server) ──────────────────────────────────────────────────────
BRAND_NAME=Example
BRAND_LEGAL_NAME=Example Limited
BRAND_WEBSITE=www.example.com
BRAND_LOGO_URL=
BRAND_MARK_URL=
BRAND_ADDRESS=
BRAND_TEL=
BRAND_REGULATORY=
BRAND_DISCLAIMER=
BRAND_COLOR_ACCENT=rgb(109, 40, 217)
BRAND_COLOR_LINK=rgb(17, 85, 204)
BRAND_COLOR_MUTED=rgb(107, 114, 128)

# ─── Branding (client, inlined at build time) ───────────────────────────────
NEXT_PUBLIC_BRAND_NAME=Example
NEXT_PUBLIC_MAIL_DOMAIN=example.com
NEXT_PUBLIC_BRAND_WEBSITE=www.example.com
NEXT_PUBLIC_MAIL_PUBLIC_URL=https://mail.example.com
NEXT_PUBLIC_BRAND_MARK_URL=
NEXT_PUBLIC_BRAND_ACCENT="#6d28d9"
# Comma-separated seed addresses offered on the sign-in screen.
NEXT_PUBLIC_MAIL_ADDRESSES=info@example.com

# ─── Seats ──────────────────────────────────────────────────────────────────
# JSON. The first admin owns the shared inbox. Seeded on first boot only.
MAIL_SEATS=[{"email":"info@example.com","address":"info@example.com","name":"Example","role":"admin"}]
# JSON. Delivery aliases: mail for the key is stored in the value's box.
MAIL_ADDRESS_ALIASES={}

# ─── Store ──────────────────────────────────────────────────────────────────
# Any SQLite/libSQL database. A file: URL is local SQLite on a mounted volume
# (simplest, and what a single box wants); a libsql:// URL is a hosted one
# (Turso or your own sqld) and needs the token below.
DATABASE_URL=file:/data/mail.sqlite
DATABASE_AUTH_TOKEN=

# Signs the session cookie. Without it every request falls back to sending the
# password on each call, so set it. Rotating the value signs everybody out.
MAIL_SESSION_SECRET=

# ─── Sending ────────────────────────────────────────────────────────────────
# Pick one: ses | resend | brevo. Fill in only that provider's keys.
MAIL_PROVIDER=ses
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=eu-north-1
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Optional: where a copy goes when inbound mail belongs to no account. Pointing this
# at an address this app receives would loop.
MAIL_FORWARD_TO=
# Set to off to stop copying inbound mail to account owners' login addresses.
MAIL_FORWARDING=on

# SES delivery events arrive through SNS at /api/mail/events/ses. Only this topic is
# accepted; leave unset and every notification is refused.
MAIL_SES_EVENTS_TOPIC_ARN=

# ─── Attachments ────────────────────────────────────────────────────────────
# Any S3-compatible bucket: AWS S3, Cloudflare R2, Backblaze B2, MinIO, Wasabi.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Region: real one for AWS, anything for R2 (defaults to "auto").
S3_REGION=
# Only if you import an mbox with --store blob (Vercel Blob).
BLOB_READ_WRITE_TOKEN=

# ─── Optional extras ────────────────────────────────────────────────────────
SAFE_BROWSING_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.com
NEXT_PUBLIC_BRAND_LEGAL_NAME=Example Limited
MAIL_ADDRESS_DOMAINS=
MAIL_DEFAULT_ADDRESS_DOMAIN=
NEXT_PUBLIC_MAIL_ADDRESS_DOMAINS=
BRAND_ICON_URL=
BRAND_APPLE_ICON_URL=
BRAND_ACCENT_HEX="#6d28d9"

# Per-tenant looks that must not carry over between brands.
# Mark drawn in the app chrome (alpha-only PNG, CSS-masked). A path under public/ or a full URL.
BRAND_CHROME_MARK_URL=/brand/mark.png
NEXT_PUBLIC_BRAND_CHROME_MARK_URL=/brand/mark.png
# Frame around the mark in email signatures: none, accent, or any CSS colour. Radius in px.
BRAND_SIGNATURE_MARK_BORDER=none
BRAND_SIGNATURE_MARK_RADIUS=0
NEXT_PUBLIC_BRAND_SIGNATURE_MARK_BORDER=none
NEXT_PUBLIC_BRAND_SIGNATURE_MARK_RADIUS=0
# The browser builds the house signature too, so the fields it prints need public twins.
NEXT_PUBLIC_BRAND_ADDRESS=
NEXT_PUBLIC_BRAND_TEL=
NEXT_PUBLIC_BRAND_REGULATORY=
NEXT_PUBLIC_BRAND_DISCLAIMER=
NEXT_PUBLIC_BRAND_COLOR_ACCENT=rgb(109, 40, 217)
NEXT_PUBLIC_BRAND_COLOR_LINK=rgb(17, 85, 204)
NEXT_PUBLIC_BRAND_COLOR_MUTED=rgb(107, 114, 128)

# Tenant images live on the volume, never in the repository. See public/brand/README.md.
BRAND_ASSET_DIR=/data/brand

# Outside production the app seeds test@$MAIL_ADDRESS_DOMAIN as an admin, password the
# same as the address, so a fresh checkout can be signed into. Never seeded when
# NODE_ENV=production.
